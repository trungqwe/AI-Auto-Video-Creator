      ],
      "invalid": [
        {
          "case": "evaluation_time_not_datetime",
          "expected_error": {
            "code": "wrong_type",
            "field": "evaluation_time"
          },
          "payload": {
            "workspace_id": "ws-0001",
            "job_ref": "00000000-0000-4000-8000-000000001101",
            "evaluation_time": "now",
            "required_config_capabilities": [
              "render_preset"
            ],
            "snapshot_state": "pre_snapshot"
          }
        },
        {
          "case": "missing_required_config_capabilities",
          "expected_error": {
            "code": "missing_required",
            "field": "required_config_capabilities"
          },
          "payload": {
            "workspace_id": "ws-0001",
            "job_ref": "00000000-0000-4000-8000-000000001101",
            "evaluation_time": "2026-10-21T08:00:00Z",
            "snapshot_state": "pre_snapshot"
          }
        }
      ]
    },
    "ConfigurationBundle": {
      "valid": [
        {
          "config_revision_refs": [
            "00000000-0000-4000-8000-000000001111"
          ],
          "merged_values": {
            "render.preset": "preset-a"
          },
