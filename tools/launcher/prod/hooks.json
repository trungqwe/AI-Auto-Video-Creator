  "recipe_templates": {
    "lavfi_gradient_pulse_v1": {
      "tool": "ffmpeg đã ghim trong tools/runtime/runtime.lock.json",
      "input": "lavfi",
      "filtergraph": "gradients=s=1080x1920:d=3:r=30:c0={c0}:c1={c1}:speed=0.02,eq=brightness='{amp}*sin(2*PI*{hz}*t)':eval=frame",
      "output_args": "-c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -r 30 -t 3 -an"
    },
    "wave_sweep_v1": {
      "tool": "python-stdlib-wave",
      "formula": "x(t)=0.5*env(t)*sin(2*PI*(220*t+(880-220)*t*t/(2*1.5)))",
      "duration_s": 1.5,
      "sample_rate_hz": 24000,
      "channels": 1,
      "sample_width_bits": 16,
      "quantize": "round(32767*x)",
      "envelopes": {
        "linear_fade_out": "1-t/1.5",
        "linear_fade_in": "t/1.5",
        "triangle": "1-abs(2*t/1.5-1)",
        "exponential_decay": "exp(-3*t/1.5)",
        "hann": "0.5-0.5*cos(2*PI*t/1.5)"
      }
    },
    "background_gradient_v1": {
      "tool": "python-stdlib-zlib-png",
      "method": "vertical_gradient",
      "top_hsv": {
        "s": 0.55,
        "v": 0.95
      },
      "bottom_hsv": {
        "s": 0.85,
        "v": 0.35
      },
      "interpolation": "linear_rgb_per_row",
      "bit_depth": 8,
      "color_type": "rgb",
      "hue_formula": "hue_degrees=(n-1)*30"
    }
  },
